# Local runtime. Copy to .env
STORAGE_BACKEND=local
WAREHOUSE_URI=file:///data/warehouse
CATALOG_TYPE=sql
CATALOG_URI=sqlite:////data/warehouse/catalog.db

KAFKA_BOOTSTRAP=localhost:9092
POSTGRES_DSN=postgresql://prism:prism@localhost:5432/bank
REDIS_URL=redis://localhost:6379/0

# Frontend (Next.js reads these from app/frontend/<app>/.env.local; defaults already match local ports)
NEXT_PUBLIC_CUSTOMER_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8001
